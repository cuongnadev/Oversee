# Application
APP_NAME=Oversee Backend
APP_VERSION=0.1.0
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000

# CORS (comma-separated origins; use * only for development)
CORS_ORIGINS=*

# Security (minimum 32 characters)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
